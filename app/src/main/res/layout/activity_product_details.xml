<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/detailBackButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textAllCaps="false" />

        <ImageView
            android:id="@+id/detailProductImage"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="12dp"
            android:contentDescription="Selected product image"
            android:padding="12dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/detailProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Product Name"
            android:textColor="#222222"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detailProductPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="₹0"
            android:textColor="#B12704"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="In stock"
            android:textColor="#16833B"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/detailProductDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="4dp"
            android:text="Product description"
            android:textColor="#444444"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Quantity"
            android:textColor="#222222"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/decreaseQuantityButton"
                android:layout_width="52dp"
                android:layout_height="48dp"
                android:text="−"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/quantityText"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="1"
                android:textColor="#222222"
                android:textSize="18sp" />

            <Button
                android:id="@+id/increaseQuantityButton"
                android:layout_width="52dp"
                android:layout_height="48dp"
                android:text="+"
                android:textSize="20sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/detailTotalPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Total: ₹0"
            android:textColor="#222222"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/detailAddToCartButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#FFD814"
            android:text="Add to Cart"
            android:textAllCaps="false"
            android:textColor="#222222"
            android:textSize="16sp" />

        <Button
            android:id="@+id/detailBuyNowButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#FFA41C"
            android:text="Buy Now"
            android:textAllCaps="false"
            android:textColor="#222222"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>
